[Unit]
Description=Mount the Trove data volumes listed in fstab (no udev in a container)
DefaultDependencies=no
After=local-fs.target
Before=docker.service guest-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/trove-data-volumes

[Install]
WantedBy=multi-user.target
