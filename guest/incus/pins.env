# The Incus layer of the shared OCI system images that the Trove guest image
# derives from, by digest: ghcr.io/fivetime/oci-system/incus, flavor
# ubuntu_noble, base apt snapshot 20261024T100000Z (tag
# ubuntu_noble-20261024T100000Z-7c6e6cee), fuse4fs in place of fuse2fs
# (the Incus driver's hw_incus_data_volume_fuse=fuse4fs) from
# fivetime/e2fsprogs 00d722f7, which lets an owner reach its own files
# (fuse4fs_inum_access left L_OK in the mask it compared). Move
# it when openstack-cloud-images publishes a newer Incus layer and the
# Incus driver's gate has passed on it.
BASE_IMAGE=ghcr.io/fivetime/oci-system/incus@sha256:bb153759beac1ce06088b0c2434e0a2fe74e7adc9384146b6b76b5a2021906d0
