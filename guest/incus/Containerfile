# The Trove guest image for Incus system containers.
#
# A Trove guest runs its database in Docker, so the image is a system image
# (systemd as PID 1, cloud-init, sshd) that also carries Docker and the
# Trove guest agent. It derives from the Incus layer of the shared OCI
# system images (openstack-cloud-images, pipelines/oci-system), which
# already satisfies the Incus driver's image contract (incus-oci-system-v1)
# including fuse2fs for Cinder data volumes. This file follows the rules
# for derived images in the driver's doc/source/oci_system_images.rst: FROM
# by digest, no CMD/ENTRYPOINT/USER/WORKDIR/ENV, software enabled as
# systemd units, no keys and no machine ID.
#
# The guest agent is the same code as in the KVM guest image: the trove
# checkout in the build context (a clone of fivetime/openstack-trove with
# its history, which pbr needs for the version; the image keeps the commit
# in /opt/guest-agent/.commit, not the history) is installed into
# /opt/guest-agent-venv exactly as trove's guest-agent dib element does,
# and its unit files are taken from that same checkout. Packages come from
# the base's apt archive snapshot, so a rebuild from the same base and the
# same trove commit gives the same image.
#
# Build (the context must contain the trove checkout as ./trove):
#   . guest/incus/pins.env
#   docker build -f guest/incus/Containerfile --build-arg BASE_IMAGE=$BASE_IMAGE \
#     --build-arg TROVE_COMMIT=$(git -C trove rev-parse HEAD) .

# The base is pinned in pins.env next to this file; the workflow passes it.
ARG BASE_IMAGE

# ---------------------------------------------------------------------------
# Stage 1: the guest agent's virtual environment, built with the compilers
# that the final image must not carry.
FROM ${BASE_IMAGE} AS agent
ARG UPPER_CONSTRAINTS_URL=https://opendev.org/openstack/requirements/raw/branch/master/upper-constraints.txt
RUN set -eu; \
    snapshot="-o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts=/usr/share/oci-system/apt -o Acquire::Retries=5"; \
    apt-get $snapshot -o APT::Update::Error-Mode=any update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $snapshot \
        build-essential git python3-dev python3-venv \
        libffi-dev libssl-dev libxml2-dev libxslt1-dev libyaml-dev; \
    rm -rf /var/lib/apt/lists/*
COPY trove /opt/guest-agent
RUN set -eu; \
    curl -fsSL --retry 5 -o /opt/upper-constraints.txt "$UPPER_CONSTRAINTS_URL"; \
    python3 -m venv /opt/guest-agent-venv; \
    /opt/guest-agent-venv/bin/pip install --no-cache-dir --upgrade pip; \
    /opt/guest-agent-venv/bin/pip install --no-cache-dir -U -c /opt/upper-constraints.txt /opt/guest-agent; \
    /opt/guest-agent-venv/bin/python -c 'import trove.cmd.guest, trove.guestagent.datastore.manager'; \
    git -C /opt/guest-agent rev-parse HEAD > /opt/guest-agent/.commit; \
    rm -rf /opt/guest-agent/.git; \
    find /opt/guest-agent-venv -name '__pycache__' -type d -prune -exec rm -rf {} +

# ---------------------------------------------------------------------------
# Stage 2: the guest image.
FROM ${BASE_IMAGE}
ARG TROVE_COMMIT
ARG GUEST_USERNAME=ubuntu

# Docker from the Ubuntu archive snapshot, with its AppArmor and iptables
# (the inner engine loads its own profiles inside the nested AppArmor
# namespace); the tools the guest agent and trove's image loader call that
# the base does not have.
RUN set -eu; \
    snapshot="-o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts=/usr/share/oci-system/apt -o Acquire::Retries=5"; \
    apt-get $snapshot -o APT::Update::Error-Mode=any update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $snapshot \
        docker.io containerd runc apparmor iptables \
        crudini psmisc rsync acl logrotate; \
    dpkg-query -W > /usr/share/oci-system/packages.txt; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY --from=agent /opt/guest-agent-venv /opt/guest-agent-venv
COPY --from=agent /opt/guest-agent /opt/guest-agent
COPY --from=agent /opt/upper-constraints.txt /opt/upper-constraints.txt

# What trove's ubuntu-guest and guest-agent dib elements do, minus the
# development-mode parts: the guest user (no password; the KVM image's
# password login is not wanted here) with passwordless sudo and Docker
# access, the agent's directories, its unit files from the same checkout,
# the docker-hostnic plugin and the image loader.
RUN set -eu; \
    src=/opt/guest-agent/integration/scripts/files/elements/guest-agent/install.d/guest-agent-source-install; \
    # ubuntu:24.04 already carries the ubuntu user (uid 1000).
    id -u "$GUEST_USERNAME" >/dev/null 2>&1 || useradd -m -s /bin/bash "$GUEST_USERNAME"; \
    usermod -aG sudo,docker "$GUEST_USERNAME"; \
    echo "$GUEST_USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/60_trove_guest; \
    chmod 0440 /etc/sudoers.d/60_trove_guest; \
    for d in /var/lib/trove /etc/trove /etc/trove/certs /etc/trove/conf.d /var/log/trove /opt/trove-guestagent; do \
        mkdir -p "$d"; chown -R "$GUEST_USERNAME":root "$d"; \
    done; \
    chown -R "$GUEST_USERNAME":root /opt/guest-agent-venv; \
    install -D -g root -o root -m 0644 "$src/guest-agent.logrotate" /etc/logrotate.d/guest-agent; \
    install -D -g root -o root -m 0755 "$src/50-trove-image-loader" /usr/local/sbin/trove-image-loader; \
    install -D -g root -o root -m 0644 "$src/trove-image-loader.service" /etc/systemd/system/trove-image-loader.service; \
    ln -s /opt/guest-agent-venv/bin/trove-docker-plugin /usr/local/bin/trove-docker-plugin; \
    ln -s /opt/guest-agent-venv/bin/trove-guestagent /usr/local/bin/guest-agent; \
    install -D -g root -o root -m 0644 "$src/docker-hostnic.socket" /lib/systemd/system/docker-hostnic.socket; \
    install -D -g root -o root -m 0644 "$src/docker-hostnic.service" /lib/systemd/system/docker-hostnic.service; \
    sed "s/GUEST_USERNAME/$GUEST_USERNAME/g" "$src/guest-agent.service" > /etc/systemd/system/guest-agent.service; \
    systemctl enable containerd.service docker.service docker-hostnic.socket guest-agent.service trove-image-loader.service; \
    # The docker-stop-timeout element: a database gets 200 s to stop.
    mkdir -p /etc/docker /etc/systemd/system/docker.service.d; \
    printf '{\n  "shutdown-timeout": 200\n}\n' > /etc/docker/daemon.json; \
    printf '[Service]\nTimeoutStopSec=200\n' > /etc/systemd/system/docker.service.d/stop-timeout.conf; \
    # The ubuntu-guest element enables forwarding (Docker does too).
    printf 'net.ipv4.ip_forward=1\n' > /etc/sysctl.d/60-trove-guest.conf; \
    test -n "$TROVE_COMMIT"; \
    test "$(cat /opt/guest-agent/.commit)" = "$TROVE_COMMIT" || { echo "trove checkout is not $TROVE_COMMIT" >&2; exit 1; }; \
    printf '%s\n' "$TROVE_COMMIT" > /usr/share/oci-system/trove-guest-commit; \
    test -x /opt/guest-agent-venv/bin/trove-guestagent; \
    command -v fuse2fs >/dev/null

LABEL org.opencontainers.image.title="Trove guest image for Incus system containers (Ubuntu 24.04)" \
      org.opencontainers.image.description="The Incus layer of the OCI system images plus Docker and the Trove guest agent; published to Glance with the Incus driver's OCI system image tool" \
      org.opencontainers.image.source="https://github.com/fivetime/openstack-trove-images" \
      io.fivetime.trove.guest-commit="${TROVE_COMMIT}" \
      io.fivetime.oci-system.layer="trove-guest"
